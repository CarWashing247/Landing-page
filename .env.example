# Every variable in AGENT.md section 7. Copy to .env and fill in.
# Never commit .env.

# --- Database ---------------------------------------------------------------
# Postgres connection string. Local dev example:
#   postgres://postgres:postgres@localhost:5432/autowash247
DATABASE_URI=

# --- Payload ----------------------------------------------------------------
# Signs admin session JWTs. Generate with: openssl rand -hex 32
# Must differ per environment — a shared secret means a session from preview
# is valid in production.
PAYLOAD_SECRET=

# --- Site -------------------------------------------------------------------
# Feeds metadataBase, canonical URLs and sitemap.xml (T-09, T-13).
# No trailing slash. Must match the environment's own origin, or every
# Open Graph image URL will be wrong.
#   local:      http://localhost:3000
#   production: https://<production-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Webhooks ---------------------------------------------------------------
# Shared secret for the revalidate webhook (T-11). Payload's afterChange
# hooks send it; /api/revalidate returns 401 without it.
REVALIDATE_SECRET=

# Shared secret for the draft preview route (T-12).
PREVIEW_SECRET=

# --- Media storage (Cloudflare R2, S3-compatible) — wired up in T-02 --------
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# --- End-to-end tests (optional) ---------------------------------------------
# An existing admin account. Login specs in e2e/ are skipped when unset.
# Use a local throwaway account, never a production one.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
