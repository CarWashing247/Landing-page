# Every variable in AGENT.md section 7. Copy to .env and fill in.
# Never commit .env.

# --- Database ---------------------------------------------------------------
# Postgres connection string. Local dev example:
#   postgres://postgres:postgres@localhost:5432/autowash247
DATABASE_URI=

# --- Payload ----------------------------------------------------------------
# Signs admin session JWTs. Generate with: openssl rand -hex 32
# Must differ per environment — a shared secret means a session from preview
# is valid in production.
PAYLOAD_SECRET=

# --- Site -------------------------------------------------------------------
# Feeds metadataBase, canonical URLs and sitemap.xml (T-09, T-13).
# No trailing slash. Must match the environment's own origin, or every
# Open Graph image URL will be wrong.
#   local:      http://localhost:3000
#   production: https://<production-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Webhooks ---------------------------------------------------------------
# Shared secret for the revalidate webhook (T-11). Payload's afterChange
# hooks send it; /api/revalidate returns 401 without it.
REVALIDATE_SECRET=

# Shared secret for the draft preview route (T-12).
PREVIEW_SECRET=

# --- Media storage (Cloudflare R2, S3-compatible) ---------------------------
# All five are required in every deployed environment. Payload refuses to
# start without them unless MEDIA_LOCAL_DISK=true, because the deploy's
# filesystem does not survive a deployment and uploads written there are lost.
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL the browser loads images from — an R2 custom domain or the
# bucket's r2.dev host. NOT the S3 endpoint above. Also added to
# next.config.mjs images.remotePatterns, without which next/image refuses it.
R2_PUBLIC_URL=

# Development only: store uploads in ./media-local instead of R2. Never set
# this in a deployed environment.
MEDIA_LOCAL_DISK=

# --- End-to-end tests (optional) ---------------------------------------------
# An existing admin account. Login specs in e2e/ are skipped when unset.
# Use a local throwaway account, never a production one.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
