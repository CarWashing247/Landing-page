# Non-secret configuration, plus the Vault bootstrap. Copy to .env and fill in.
# Never commit .env.
#
# CREDENTIALS DO NOT BELONG IN THIS FILE. They live in HashiCorp Vault and are
# read once when the process starts, by loadSecrets() in src/lib/secrets.ts.
# AGENT.md section 7 is the contract; section 7.2 lists what Vault holds.
#
# Local setup, in full:
#   docker compose up -d        # Postgres + Vault (dev mode)
#   ./scripts/vault-seed.sh     # seeds the dev path, prints the two lines below
#   npm run dev
#
# Vault dev mode keeps nothing, so re-run the seed script after every restart.

# --- Vault ------------------------------------------------------------------
# Everything here is addressing, except the AppRole pair at the bottom, which
# is the one credential that cannot live in Vault — a secret store cannot hold
# the key to itself. Access to these is access to this environment's secrets.
VAULT_ADDR=http://127.0.0.1:8200

# HCP Vault requires 'admin'. Leave unset for the local dev server; set wrong
# or unset against HCP and every read 403s with a message that never mentions
# namespaces.
VAULT_NAMESPACE=

# KV v2 path for THIS environment, as "<mount>/<path>". One path per
# environment, each with its own AppRole, so a leaked preview role cannot read
# production:
#   local:      kv/autowash247/development
#   preview:    kv/autowash247/preview
#   production: kv/autowash247/production
VAULT_SECRET_PATH=kv/autowash247/development

# Printed by ./scripts/vault-seed.sh locally; issued per environment from the
# HCP cluster for the deployed ones.
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# --- Database ---------------------------------------------------------------
# Postgres connection string. Stays in the environment: it is per-environment
# infrastructure config, and `payload migrate` needs it in the deploy's build
# step. Local dev example matches docker-compose.yml:
#   postgres://postgres:postgres@localhost:5432/autowash247
DATABASE_URI=

# --- Site -------------------------------------------------------------------
# Feeds metadataBase, canonical URLs and sitemap.xml (T-09, T-13).
# No trailing slash. Must match the environment's own origin, or every
# Open Graph image URL will be wrong.
#
# NEXT_PUBLIC_* is inlined into the client bundle at build time, so Vault
# cannot supply it — and nothing secret may ever be given a NEXT_PUBLIC_ name.
#   local:      http://localhost:3000
#   production: https://<production-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Media storage ----------------------------------------------------------
# The four R2 credentials (R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# R2_ENDPOINT) are in Vault. R2_PUBLIC_URL is NOT, and cannot be: next.config.mjs
# reads it at build time to build images.remotePatterns, which is baked into the
# build output. It is a public CDN hostname, not a credential.
#
# Public base URL the browser loads images from — an R2 custom domain or the
# bucket's r2.dev host. NOT the S3 endpoint, which is R2_ENDPOINT in Vault.
R2_PUBLIC_URL=

# Development only: store uploads in ./media-local instead of R2, which also
# makes the four R2 credentials in Vault optional. A fresh clone needs it,
# because the seed script does not write R2 credentials to the dev path.
#
# Never set this in a deployed environment — the filesystem does not survive a
# deployment and uploads written there are lost. That is no longer merely a
# warning: resolveR2Config() throws when VERCEL_ENV is set, so this reaching a
# deploy fails the boot instead of silently losing uploads.
MEDIA_LOCAL_DISK=true

# --- Logging (optional) ------------------------------------------------------
# debug | info | error. Unset behaves as info. Every log line goes through
# logger() in src/lib/log.ts (AGENT.md section 5.8), never console.log.
#
# Keep `debug` to a local machine. In a deployed environment it logs a line per
# internal step, and Vercel bills log retention beyond its included allowance —
# which is why this is left unset here rather than shipped as `debug`.
LOG_LEVEL=

# --- End-to-end tests (optional) ---------------------------------------------
# Throwaway local accounts for the login and access-control specs in e2e/,
# which skip when these are unset. Never set in a deployed environment.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_EDITOR_EMAIL=
E2E_EDITOR_PASSWORD=
